#!/usr/bin/env python3
"""
Impression Bot - Bot de Telegram dedicado al grupo "Impresión"
Funcionalidades:
- Recibir fotos y documentos
- Aplicar mejora local de imagen antes de imprimir
- Enviar a la impresora Canon PIXMA G3110
- Registrar impresiones en logger
"""

import os
import sys
import json
import logging
import asyncio
import tempfile
import subprocess
from pathlib import Path
from telegram import Update
from telegram.ext import Application, CommandHandler, MessageHandler, filters, ContextTypes

# Importar logger de impresión y mejora de fotos
sys.path.insert(0, '/path/to/your/media/scripts')
from rio_print_logger import log_print
from photo_enhance import EnhanceConfig, enhance_photo_from_config

# F1: inspector + carriles + estampa de fecha (print-bot-enhance)
sys.path.insert(0, '/root/my_print_bot/enhance_f1')
import pipeline as photo_pipeline
import watermark as wm

# Pendientes de fecha: {user_id: [(future, deadline, message_id), ...]} por foto
PENDING_DATE: dict[int, list] = {}

# Configuración
BOT_TOKEN = os.getenv("IMPRESSION_BOT_TOKEN", "TU_TOKEN_AQUI")
LOG_FILE = "/var/log/impression_bot.log"
STATUS_FILE = "/tmp/impression_bot_status.txt"
BOT_CONFIG_PATH = "/root/.bot_data/memory/impression-bot-config.json"

# Seguridad — solo Christian puede imprimir
ALLOWED_USER_IDS = [123456789]

# Configuración de impresión - Canon PIXMA G3110 via LPD al router
CANON_PRINTER = "Fotos"

# Setup logging
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO,
    handlers=[
        logging.FileHandler(LOG_FILE),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)


def load_bot_config() -> dict:
    """Cargar configuración completa del bot."""
    path = Path(BOT_CONFIG_PATH)
    if path.exists():
        try:
            with open(path, "r") as f:
                return json.load(f)
        except Exception as e:
            logger.warning(f"Error cargando config: {e}")
    return {
        "default": {
            "size": "5x7",
            "crop_strategy": "center",
            "filter_profile": "auto",
            "ppi": 600,
            "enhance_enabled": True
        },
        "users": {}
    }


def save_bot_config(data: dict) -> None:
    """Guardar configuración completa del bot."""
    path = Path(BOT_CONFIG_PATH)
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)


def get_user_config(user_id: int) -> EnhanceConfig:
    """Cargar configuración de mejora para un usuario."""
    data = load_bot_config()
    defaults = data.get("default", {})
    users = data.get("users", {})
    user_cfg = users.get(str(user_id), {})
    merged = {**defaults, **user_cfg}
    return EnhanceConfig(**merged)


def set_user_config(user_id: int, config: EnhanceConfig) -> None:
    """Guardar configuración de mejora para un usuario."""
    data = load_bot_config()
    data.setdefault("users", {})
    data["users"][str(user_id)] = {
        "size": config.size,
        "crop_strategy": config.crop_strategy,
        "filter_profile": config.filter_profile,
        "ppi": config.ppi,
        "enhance_enabled": config.enhance_enabled,
    }
    save_bot_config(data)


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Handler for /start command"""
    user = update.effective_user
    await update.message.reply_html(
        rf"¡Hola {user.mention_html()}! 📸🖨️\n\n"
        "Soy el bot de impresión. Envíame una foto y yo la imprimo automáticamente en la Canon PIXMA G3110.\n\n"
        "Formato: 13x18 cm (5x7 pulgadas)\n"
        "Calidad: Fotográfica 600ppi\n"
        "🎨 Mejora automática: activada por defecto\n\n"
        "<b>Comandos:</b>\n"
        "/help - Ayuda\n"
        "/status - Estado del sistema\n"
        "/size - Cambiar tamaño de papel (5x7 / 4x6)\n"
        "/enhance - Activar/desactivar mejora automática\n"
        "/crop - Recorte opcional al papel (none/center/entropy/face)\n"
        "/filter - Perfil de ajuste (auto/vivid/soft/none)\n"
        "/ping - Test de conectividad\n"
        "/pause - Pausar cola\n"
        "/resume - Reanudar trabajos pausados"
    )


async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Handler for /help command"""
    help_text = """📋 <b>Comandos disponibles:</b>

/start - Iniciar el bot
/help - Mostrar esta ayuda
/size - Cambiar tamaño de papel (5x7 / 4x6)
/enhance - Activar/desactivar mejora automática
/crop - Recorte opcional al papel (none/center/entropy/face)
/filter - Perfil de ajuste (auto/vivid/soft/none)
/status - Estado del sistema
/queue - Ver cola de impresión
/ping - Test de conectividad
/pause - Pausar cola de impresión
/resume - Reanudar trabajos pausados

<b>Para imprimir:</b>
Envíame una foto (como imagen, no como archivo). La mejoraré automáticamente y la enviaré a la Canon PIXMA G3110 en formato 13x18 cm, calidad fotográfica.
"""
    await update.message.reply_text(help_text, parse_mode='HTML')


async def set_paper_size(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Handler for /size - Change paper size (5x7 or 4x6)"""
    user = update.effective_user
    if user.id not in ALLOWED_USER_IDS:
        await update.message.reply_text("❌ No autorizado.")
        return

    config = get_user_config(user.id)

    args = context.args
    if not args:
        await update.message.reply_text(
            f"📐 Tamaño actual: {config.size} "
            f"({'13x18 cm' if config.size == '5x7' else '10x15 cm'})\n\n"
            "Para cambiarlo:\n"
            "/size 5x7  - 13x18 cm\n"
            "/size 4x6  - 10x15 cm"
        )
        return

    new_size = args[0].lower()
    if new_size not in ('4x6', '5x7'):
        await update.message.reply_text("❌ Tamaño no válido. Usa: /size 5x7 o /size 4x6")
        return

    config.size = new_size
    set_user_config(user.id, config)

    label = "13x18 cm" if new_size == "5x7" else "10x15 cm"
    await update.message.reply_text(
        f"✅ Tamaño cambiado a {label} ({new_size})\n\n"
        "La próxima foto se imprimirá en ese formato."
    )
    logger.info(f"Paper size changed to {new_size} ({label}) by {user.first_name}")


async def toggle_enhance(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Handler for /enhance - Activar/desactivar mejora automática."""
    user = update.effective_user
    if user.id not in ALLOWED_USER_IDS:
        await update.message.reply_text("❌ No autorizado.")
        return

    config = get_user_config(user.id)
    args = context.args

    if not args:
        status = "✅ Activada" if config.enhance_enabled else "⏸️ Desactivada"
        await update.message.reply_text(
            f"🎨 Mejora automática: {status}\n\n"
            f"📐 Tamaño: {config.size}\n"
            f"✂️ Recorte: {config.crop_strategy}\n"
            f"🌈 Filtro: {config.filter_profile}\n"
            f"🖨️ PPI: {config.ppi}\n\n"
            "Para cambiar:\n"
            "/enhance on\n"
            "/enhance off"
        )
        return

    arg = args[0].lower()
    if arg in ("on", "1", "true", "si", "sí"):
        config.enhance_enabled = True
        set_user_config(user.id, config)
        await update.message.reply_text(
            "✅ Mejora automática ACTIVADA.\n\n"
            "Las próximas fotos se ajustarán automáticamente antes de imprimir."
        )
    elif arg in ("off", "0", "false", "no"):
        config.enhance_enabled = False
        set_user_config(user.id, config)
        await update.message.reply_text(
            "⏸️ Mejora automática DESACTIVADA.\n\n"
            "Las fotos se imprimirán tal cual las envíes."
        )
    else:
        await update.message.reply_text("❌ Opción no válida. Usa: /enhance on o /enhance off")


async def set_crop_strategy(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Handler for /crop - Elegir estrategia de recorte."""
    user = update.effective_user
    if user.id not in ALLOWED_USER_IDS:
        await update.message.reply_text("❌ No autorizado.")
        return

    config = get_user_config(user.id)
    args = context.args
    valid = ["none", "center", "entropy", "face"]

    if not args:
        await update.message.reply_text(
            f"✂️ Estrategia de recorte actual: {config.crop_strategy}\n\n"
            "Por defecto no se recorta, manteniendo la foto completa.\n\n"
            "Opciones:\n"
            "/crop none    - Sin recorte (default)\n"
            "/crop center  - Recorte centrado al tamaño de papel\n"
            "/crop entropy - Zona más interesante (deshabilitado)\n"
            "/crop face    - Centrado en caras (deshabilitado)"
        )
        return

    strategy = args[0].lower()
    if strategy not in valid:
        await update.message.reply_text("❌ Estrategia no válida. Opciones: none, center, entropy, face")
        return

    if strategy in ("entropy", "face"):
        await update.message.reply_text(
            f"⚠️ '{strategy}' aún no está disponible en este entorno.\n"
            "Se usará recorte centrado como fallback."
        )

    config.crop_strategy = strategy
    set_user_config(user.id, config)
    await update.message.reply_text(
        f"✅ Estrategia de recorte cambiada a: {strategy}\n\n"
        "Aplicará en la próxima foto."
    )


